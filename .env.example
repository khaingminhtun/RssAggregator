# Copy to .env and adjust if needed:  cp .env.example .env
# For "make run" (app on host): use POSTGRES_HOST=localhost, REDIS_HOST=localhost

# ----------------------
# App
# ----------------------
ADDR=:4000
APP_PORT=4000

# ----------------------
# JWT (required; use a long random string in production)
# ----------------------
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=rssagg
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ----------------------
# PostgreSQL (for make run use localhost; for Docker app use db)
# ----------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=rssagg
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_PORT=5432
DB_CONTAINER=my_postgres

# ----------------------
# Redis (for make run use localhost; for Docker app use redis)
# ----------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ----------------------
# pgAdmin (optional, for docker compose)
# ----------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=8080
